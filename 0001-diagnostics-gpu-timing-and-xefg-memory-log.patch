diff --git a/src/GpuTimer.h b/src/GpuTimer.h
new file mode 100644
index 0000000..9cd6ae5
--- /dev/null
+++ b/src/GpuTimer.h
@@ -0,0 +1,225 @@
+#pragma once
+
+#include "Log.h"
+
+#include <Windows.h>
+#include <d3d12.h>
+#include <wrl/client.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <format>
+#include <string>
+
+// Diagnostics for finding out what is worth optimizing. Everything here is off unless the environment variable
+// DLSSG_TO_XEFG_DIAGNOSTICS is 1, so the default path records exactly the same commands as before.
+//
+// GpuTimer measures the regions this shim records into the game's own command list. The timestamps are resolved into a
+// readback buffer inside that list and read many intervals later without waiting on a fence, so the numbers only go
+// to the log and nothing else depends on them.
+class GpuTimer
+{
+public:
+	static bool DiagnosticsEnabled()
+	{
+		static const bool enabled = []
+			{
+				char value[8]{};
+				return GetEnvironmentVariableA("DLSSG_TO_XEFG_DIAGNOSTICS", value, sizeof(value)) == 1 && value[0] == '1';
+			}();
+
+		return enabled;
+	}
+
+	enum Region : uint32_t
+	{
+		Capture,      // copies of the real frame's inputs, once per real frame
+		ExecutePair,  // XeFG Execute of generated frame 1: the per pair work plus that frame
+		ExecuteFrame, // XeFG Execute of generated frames 2 and up
+		OutputCopy,   // the generated frame copied into the game's output
+		RegionCount,
+	};
+
+	// Brackets one region of a command list, does nothing while diagnostics are off
+	class Scope
+	{
+	public:
+		Scope(GpuTimer& timer, ID3D12GraphicsCommandList* cmdList, Region region)
+			: timer(timer), cmdList(cmdList), index(timer.Begin(cmdList, region))
+		{
+		}
+
+		~Scope()
+		{
+			if (index >= 0)
+				timer.End(cmdList, index);
+		}
+
+		Scope(const Scope&) = delete;
+		Scope& operator=(const Scope&) = delete;
+
+	private:
+		GpuTimer& timer;
+		ID3D12GraphicsCommandList* cmdList;
+		int64_t index;
+	};
+
+private:
+	// A ring of begin/end timestamp pairs. 256 of them cover several real frames in flight even at 6x
+	static constexpr uint32_t Intervals = 256;
+	// The reader stays this far behind the writer. The GPU has to be closer than that to the CPU for the numbers to hold
+	static constexpr uint32_t ReadBehind = 128;
+	static constexpr uint32_t ReportEvery = 480;
+
+	struct Stat
+	{
+		uint64_t count = 0;
+		double sum = 0.0;
+		double max = 0.0;
+	};
+
+	int64_t Begin(ID3D12GraphicsCommandList* cmdList, Region region)
+	{
+		if (!DiagnosticsEnabled() || (tried && !heap))
+			return -1;
+
+		if (!tried)
+		{
+			tried = true;
+
+			if (!Create(cmdList))
+			{
+				heap.Reset();
+				readback.Reset();
+				Log::Warn("GPU timing is unavailable, creating the timestamp query resources failed");
+				return -1;
+			}
+		}
+
+		const int64_t index = (int64_t)written++;
+		const uint32_t slot = (uint32_t)(index % Intervals);
+		regions[slot] = region;
+		cmdList->EndQuery(heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, slot * 2);
+		return index;
+	}
+
+	void End(ID3D12GraphicsCommandList* cmdList, int64_t index)
+	{
+		const uint32_t slot = (uint32_t)(index % Intervals);
+		cmdList->EndQuery(heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, slot * 2 + 1);
+		cmdList->ResolveQueryData(heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, slot * 2, 2, readback.Get(),
+			slot * 2 * sizeof(uint64_t));
+
+		Collect();
+	}
+
+	bool Create(ID3D12GraphicsCommandList* cmdList)
+	{
+		Microsoft::WRL::ComPtr<ID3D12Device> device;
+
+		if (FAILED(cmdList->GetDevice(IID_PPV_ARGS(&device))))
+			return false;
+
+		D3D12_QUERY_HEAP_DESC queryHeap{};
+		queryHeap.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+		queryHeap.Count = Intervals * 2;
+
+		if (FAILED(device->CreateQueryHeap(&queryHeap, IID_PPV_ARGS(&heap))))
+			return false;
+
+		D3D12_HEAP_PROPERTIES props{ D3D12_HEAP_TYPE_READBACK };
+		D3D12_RESOURCE_DESC desc{};
+		desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+		desc.Width = Intervals * 2 * sizeof(uint64_t);
+		desc.Height = 1;
+		desc.DepthOrArraySize = 1;
+		desc.MipLevels = 1;
+		desc.SampleDesc.Count = 1;
+		desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+
+		// A readback buffer starts in COPY_DEST and stays there, which is what ResolveQueryData wants
+		if (FAILED(device->CreateCommittedResource(&props, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST,
+			nullptr, IID_PPV_ARGS(&readback))))
+		{
+			return false;
+		}
+
+		// Any direct queue of the device ticks at the same rate, the game's own queue isn't known here
+		D3D12_COMMAND_QUEUE_DESC queueDesc{};
+		queueDesc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+		Microsoft::WRL::ComPtr<ID3D12CommandQueue> queue;
+
+		return SUCCEEDED(device->CreateCommandQueue(&queueDesc, IID_PPV_ARGS(&queue))) &&
+			SUCCEEDED(queue->GetTimestampFrequency(&frequency)) && frequency != 0;
+	}
+
+	// Reads the intervals the GPU should have finished long ago
+	void Collect()
+	{
+		while (read + ReadBehind < written)
+		{
+			const uint32_t slot = (uint32_t)(read % Intervals);
+			read++;
+
+			const D3D12_RANGE range{ slot * 2 * sizeof(uint64_t), (slot + 1) * 2 * sizeof(uint64_t) };
+			uint64_t* data = nullptr;
+
+			if (FAILED(readback->Map(0, &range, reinterpret_cast<void**>(&data))) || !data)
+				continue;
+
+			const uint64_t begin = data[slot * 2];
+			const uint64_t end = data[slot * 2 + 1];
+
+			const D3D12_RANGE nothingWritten{};
+			readback->Unmap(0, &nothingWritten);
+
+			// Zero is a slot the GPU hasn't written yet
+			if (begin != 0 && end > begin)
+			{
+				const double ms = (double)(end - begin) * 1000.0 / (double)frequency;
+
+				if (ms < 1000.0)
+				{
+					Stat& stat = stats[regions[slot]];
+					stat.count++;
+					stat.sum += ms;
+					stat.max = std::max(stat.max, ms);
+				}
+			}
+
+			if (++sinceReport >= ReportEvery)
+				Report();
+		}
+	}
+
+	void Report()
+	{
+		static constexpr const char* Names[RegionCount] = { "capture", "execute pair", "execute frame", "output copy" };
+
+		std::string line;
+
+		for (uint32_t i = 0; i < RegionCount; i++)
+		{
+			Stat& stat = stats[i];
+
+			if (stat.count)
+				line += std::format(" {} {:.3f}/{:.3f} (n={});", Names[i], stat.sum / (double)stat.count, stat.max, stat.count);
+
+			stat = Stat{};
+		}
+
+		sinceReport = 0;
+		Log::Info("GPU time avg/max in ms:{}", line);
+	}
+
+	Microsoft::WRL::ComPtr<ID3D12QueryHeap> heap;
+	Microsoft::WRL::ComPtr<ID3D12Resource> readback;
+	uint64_t frequency = 0;
+	bool tried = false;
+
+	uint64_t written = 0; // intervals begun
+	uint64_t read = 0;    // intervals consumed
+	uint32_t sinceReport = 0;
+	Region regions[Intervals]{};
+	Stat stats[RegionCount]{};
+};
